@startuml
!include style.puml
skinparam nodesep 8
skinparam ranksep 22

node "Developer machine" as DEV {
  artifact "Kotlin source,\ndocs/HANDOFF.md" as SRC
  artifact "tools/stellarium_import\n(Stellarium data, HYG)" as IMP
}

node "GitHub" as GH {
  database "Repository\n(source and assets)" as REPO
  node "GitHub Actions\n(ubuntu-latest)" as GA {
    artifact "build: tests, assemble,\nsky-data check" as BUILD
    artifact "ui-check: desktop\ntests, screenshots" as UIC
    artifact "secret-scan: gitleaks\nover the history" as SEC
    artifact "bundle (Release workflow,\ntag v*): signed AAB and APK" as REL
  }
  node "GitHub Releases" as GR {
    artifact "AstroFixxer.apk\n(latest-build)" as APK
  }
}

node "Android phone (8.0+)" as PH {
  artifact "AstroFixxer APK\nwith sky data in assets" as APP
}

cloud "CelesTrak" as CT

IMP -right-> SRC : writes\nassets
SRC -right-> REPO : git push
REPO --> BUILD : every push
REPO --> UIC : every push
REPO --> SEC : every push
REPO --> REL : tag v*
BUILD --> APK : publish on\npush to main
REL --> GR : release APK
APK --> APP : download\nand install
APP .right.> CT : orbit elements,\nonline only
BUILD -[hidden]right- UIC
UIC -[hidden]right- SEC
SEC -[hidden]right- REL
@enduml
