@startuml
!include style.puml
skinparam nodesep 14
skinparam ranksep 26
skinparam stateFontSize 11
skinparam ArrowFontSize 10
hide empty description

[*] --> NOT_ALIGNED : launch
[*] --> ALIGNED : saved calibration\nrestored

state NOT_ALIGNED
state PICK_STAR : tap a star to centre\ndrag moves the map
state CENTER_STAR : centre star in eyepiece,\ndrag map under the +
state ALIGNED : alignMatrix set

NOT_ALIGNED --> PICK_STAR : startAlign()
ALIGNED --> PICK_STAR : startAlign() or\ncheck with another star
NOT_ALIGNED --> CENTER_STAR : beginCentering(star)\n("Align using this star")
PICK_STAR --> PICK_STAR : pickStar(o) refused\n(Sun, Moon, not a star or\nplanet, below horizon)
PICK_STAR --> CENTER_STAR : pickStar(o) accepted
ALIGNED --> CENTER_STAR : Retry
CENTER_STAR --> ALIGNED : confirmAlignment()\n[star up, matrix valid]
CENTER_STAR --> CENTER_STAR : confirm refused\n(star below horizon,\nmatrix not computed)
PICK_STAR --> NOT_ALIGNED : cancelAlign()\n[no calibration]
CENTER_STAR --> NOT_ALIGNED : cancelAlign()\n[no calibration]
PICK_STAR --> ALIGNED : cancelAlign()\n[has calibration]
CENTER_STAR --> ALIGNED : cancelAlign()\n[has calibration]
ALIGNED --> NOT_ALIGNED : clearAlignment()\n(mounting changed,\nReset all)
@enduml
