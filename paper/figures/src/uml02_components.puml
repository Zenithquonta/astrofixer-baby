@startuml
!include style.puml
skinparam nodesep 10
skinparam ranksep 16
skinparam componentStyle rectangle

rectangle "MainActivity (the only Android code)\nsensors, location, speech, preferences,\nasset loading, orbit download (CelesTrak)" as MA

package "ui/  (Compose, no Android imports)" as UI {
  rectangle "SkyScreen SkyCanvas\nSheets ObjectInfo" as SC
  rectangle "SkyState" as SS
  rectangle "SkyMarkings SkyScenery Visibility\nUpcomingEvents AstroGuide I18n" as UI2
}

package "astro/  (pure Kotlin, no Android imports)" as AS {
  rectangle "Pointing\nApparentPosition" as P
  rectangle "Catalog UserLists\nCoordinateParser" as CAT
  rectangle "Events MinorBodies\nSatellites Sgp4" as EV
  rectangle "PlateSolver StarDetector\nSolverStars" as PS
}

folder "assets/" as ASSETS {
  file "sky_catalog.json.gz\nminor_bodies.json\nmeteor_showers.json, art/" as A1
  file "solver_stars.bin" as A2
}

MA --> SS
MA --> SC
SC --> SS
UI2 --> SS
SS --> P
SS --> CAT
UI2 --> EV
MA ..> A1 : loads
PS ..> A2 : reads\n(not yet called from ui/)
SC -[hidden]right- UI2
SC -[hidden]right- SS
P -[hidden]right- CAT
CAT -[hidden]right- EV
EV -[hidden]right- PS
A1 -[hidden]right- A2
@enduml
